# Copy to zen-bridge.env and edit. All optional.

# Your Zen key from https://opencode.ai/workspace — required for every free
# model except space-bunny-free, which is anonymous.
# OPENCODE_API_KEY=sk-...

# Which Zen model to expose. Free models:
#   space-bunny-free               (works with no key at all)
#   big-pickle
#   mimo-v2.6-flash-free
#   mimo-v2.5-free
#   ling-3.0-flash-fin-free
#   nemotron-3-ultra-free
#   nemotron-3.5-lightning-free
#   longcat-2.5-preview-free
#   muse-spark-1.3-contributor-free
ZEN_MODEL=space-bunny-free

# Ports (change if something already owns them)
BRIDGE_PORT=4701
OPENCODE_PORT=4611

# Directory opencode treats as the project root.
# OPENCODE_DIR=/path/to/your/project
